# ---------------------------------------------------------------------------
# Conversia API — environment
#
# Copy to `.env` and fill in. Every variable is validated at boot, so a
# misconfigured deployment fails immediately with a readable message rather
# than throwing from inside a request handler hours later.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
LOG_LEVEL=info

# --- Database --------------------------------------------------------------
# Either set DATABASE_URL, or the discrete PG* values below.
# DATABASE_URL=postgres://user:password@host:5432/conversia
PGHOST=localhost
PGPORT=5432
PGDATABASE=conversia
PGUSER=postgres
PGPASSWORD=
PGSSL=false
PG_POOL_MAX=10

# --- Authentication --------------------------------------------------------
# REQUIRED. Generate with: openssl rand -base64 48
# Use different values for each secret and rotate them independently.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Short access tokens keep a stolen one useful only briefly; the refresh token
# is rotated on every use with reuse detection, so a leak is caught.
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Password hashing cost. Raise until a sign-in takes ~200-300ms on your
# production hardware; the right number differs between a laptop and a server.
BCRYPT_ROUNDS=12

AUTH_COOKIE_NAME=conversia_refresh
# Set to true whenever the API is served over HTTPS. Must be true in production.
COOKIE_SECURE=false
# Only needed when the API and frontend share a parent domain.
# COOKIE_DOMAIN=.example.com

# --- CORS ------------------------------------------------------------------
# Comma-separated allowlist of browser origins. Never a wildcard: credentialed
# requests forbid it, and reflecting the caller's origin defeats the purpose.
CORS_ORIGINS=http://localhost:3000

# --- Uploads ---------------------------------------------------------------
UPLOAD_DIR=storage/uploads
MAX_UPLOAD_BYTES=26214400

# --- Rate limiting ---------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=600
# Stricter, and keyed on the address being tried as well as the source IP.
AUTH_RATE_LIMIT_MAX=20

# --- Demo seed -------------------------------------------------------------
# The password every seeded account gets. `db:seed` refuses to run when
# NODE_ENV=production.
SEED_PASSWORD=Conversia!2026

# --- AI layer ---
# Leave AI_PROVIDER=none and the product runs without it: documents are stored
# but not indexed, retrieval reports that it is not installed, and the widget
# falls back honestly. Nothing here is required for the server to boot.
AI_PROVIDER=none
# Ollama (local):
#   AI_PROVIDER=ollama
#   AI_BASE_URL=http://localhost:11434
#   AI_EMBEDDING_MODEL=nomic-embed-text:latest
#   AI_EMBEDDING_DIMENSIONS=768
#   AI_CHAT_MODEL=qwen3:8b
# OpenAI (cloud) — note the dimension change needs a migration and a re-index:
#   AI_PROVIDER=openai
#   AI_BASE_URL=https://api.openai.com/v1
#   AI_API_KEY=sk-...
#   AI_EMBEDDING_MODEL=text-embedding-3-small
#   AI_EMBEDDING_DIMENSIONS=1536
#   AI_CHAT_MODEL=gpt-4o-mini
# xKiro (or any other OpenAI-compatible chat aggregator) for chat, with
# embeddings kept on Ollama — most free chat aggregators have no embeddings
# endpoint at all, so chat and embeddings are configured independently:
#   AI_PROVIDER=none
#   AI_CHAT_PROVIDER=openai
#   AI_CHAT_BASE_URL=https://api.xkiro.com/v1
#   AI_CHAT_API_KEY=xkiro_...
#   AI_CHAT_MODEL=deepseek/deepseek-v4-flash
#   AI_EMBEDDING_PROVIDER=ollama
#   AI_EMBEDDING_BASE_URL=http://localhost:11434
#   AI_EMBEDDING_MODEL=nomic-embed-text:latest
#   AI_EMBEDDING_DIMENSIONS=768
# xKiro for chat, Voyage AI for embeddings — the production pairing: neither
# vendor does the other's job (Voyage has no chat endpoint either), and
# Voyage's free tier (200M tokens for voyage-4-lite at signup) makes it a real
# embeddings option with no local model to host. output_dimension is sent on
# every request, so pick a value voyage-4-lite actually supports — 256, 512,
# 1024 or 2048 — and re-index if you ever change it, same as any embedding
# model swap:
#   AI_PROVIDER=none
#   AI_CHAT_PROVIDER=openai
#   AI_CHAT_BASE_URL=https://api.xkiro.com/v1
#   AI_CHAT_API_KEY=xkiro_...
#   AI_CHAT_MODEL=deepseek/deepseek-v4-flash
#   AI_EMBEDDING_PROVIDER=voyage
#   AI_EMBEDDING_API_KEY=pa-...
#   AI_EMBEDDING_MODEL=voyage-4-lite
#   AI_EMBEDDING_DIMENSIONS=1024

# --- Credentials at rest ---
# Required only to store a workspace's SMTP password. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# There is deliberately no default: a key shared by every deployment is the same
# as no encryption at all.
ENCRYPTION_KEY=
